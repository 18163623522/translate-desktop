{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "translate-desktop",
  "version": "0.1.0",
  "identifier": "com.iftdesktop.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "沉浸式免费翻译",
        "width": 1100,
        "height": 760,
        "center": true,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
